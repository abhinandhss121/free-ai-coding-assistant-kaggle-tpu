# Copy these placeholders into your local shell or private .env file.
# Do not put real credentials in Git.

# Base URL printed by the active Kaggle notebook session
ANTHROPIC_BASE_URL=https://REPLACE-WITH-YOUR-SESSION-URL
# API key printed by the active Kaggle notebook session
ANTHROPIC_AUTH_TOKEN=REPLACE_WITH_YOUR_SESSION_API_KEY
# Use the model identifier printed by the notebook
ANTHROPIC_MODEL=REPLACE_WITH_MODEL_ID
